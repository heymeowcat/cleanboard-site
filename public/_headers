# GitHub Pages custom headers
# https://docs.github.com/en/pages/configuring-a-custom-domain-for-your-github-pages-site/managing-a-custom-domain-for-your-github-pages-site
#
# These are applied by GitHub Pages when the site is served from a
# repository with Pages enabled. They harden the deployment and let the
# static assets be cached for a year.

/*
  # Only ever serve the site over HTTPS. The `includeSubDomains` and
  # `preload` directives let the browser and the HSTS preload list know
  # that this host is HTTPS-only.
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  # The site loads nothing from other origins, so the policy can be strict.
  # Inline styles are needed because Astro inlines the stylesheets.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'

# Fingerprinted build output — safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The self-hosted variable fonts are content-hashed by Vite as well.
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Images are content-stable but not fingerprinted, so cache them for a week.
/*.png
  Cache-Control: public, max-age=604800
/*.webp
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800

# HTML must always be revalidated so a deploy is picked up immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/sitemap-index.xml
  Cache-Control: public, max-age=3600
/sitemap-0.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
