---
import Layout from "../../layouts/Layout.astro";
import DownloadContent from "../../components/DownloadContent.astro";
import { breadcrumbSchema, howToSchema, organizationSchema } from "../../lib/schema";
import { PLAY_STORE_ID } from "../../lib/site";

const steps = [
    {
        name: "CleanBoard ස්ථාපනය කරන්න",
        text: `Google Play පිටුවේ CleanBoard (පැකේජ් ${PLAY_STORE_ID}) විවෘත කර Install කරන්න. යෙදුම නොමිලේ වන අතර දැන්වීම් හෝ යෙදුම් තුළ මිල ගණන් ගැනීම් නැත.`,
    },
    {
        name: "Android සැකසුම්වල සක්‍රිය කරන්න",
        text: "Settings → System → Languages & input → On-screen keyboard යන කොටසට ගොස්, ස්ථාපනය කළ යතුරුපුවරු ලැයිස්තුවෙන් CleanBoard තෝරන්න.",
    },
    {
        name: "පෙරනිමි යතුරුපුවරුව ලෙස සකසන්න",
        text: "CleanBoard අසල ඇති ගියර් ලකුණ ඔබන්න, ඔබට අවශ්‍ය පිහිටුම් සඳහා ස්විච සක්‍රිය කරන්න. ලියද්දී ග්ලෝබ් යතුර මගින් ඒවා අතර මාරු විය හැක.",
    },
    {
        name: "සිංහල ලියන්න",
        text: "Singlish හෝ Phonetic පිහිටුමට මාරු වී සරල ඉංග්‍රීසි අකුරු ලියන්න. CleanBoard ඒවා ඔබ ලියන විටම සිංහලට හරවයි — මෙම වෙබ් අඩවියේ පරිවර්තකයේ ඇති එකම එන්ජිම භාවිත කරමින්.",
    },
];

const jsonLd = [
    organizationSchema(),
    breadcrumbSchema([
        { name: "Home", path: "/si/" },
        { name: "බාගන්න", path: "/si/download/" },
    ]),
    howToSchema(
        "ඇන්ඩ්‍රොයිඩ් සඳහා CleanBoard සිංහල යතුරුපුවරුව ස්ථාපනය කරන ආකාරය",
        "Google Play හරහා CleanBoard ස්ථාපනය කර පියවර හතරකින් පෙරනිමි යතුරුපුවරුව ලෙස සක්‍රිය කරන්න.",
        steps,
    ),
];
---

<Layout
    title="CleanBoard බාගන්න — නොමිලේ"
    description="නොමිලේ CleanBoard සිංහල සහ ඉංග්‍රීසි යතුරුපුවරුව බාගන්න. නොබැඳි ටයිප් කිරීම, පිහිටුම් හතර, Singlish එන්ජිම සහ ඔබ සක්‍රිය කරන තෙක් නිශ්චල අමතර අංග."
    path="/si/download/"
    lang="si"
    alternates={{ en: "/download/", si: "/si/download/" }}
    jsonLd={jsonLd}
>
    <DownloadContent lang="si" />
</Layout>
