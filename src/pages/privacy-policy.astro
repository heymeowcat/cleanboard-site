---
import Layout from "../layouts/Layout.astro";
import { CONTACT_EMAIL } from "../lib/site";
import { breadcrumbSchema, organizationSchema } from "../lib/schema";

/** Updated whenever the policy text changes. */
const lastUpdated = "October 22, 2026";

const jsonLd = [
    organizationSchema(),
    breadcrumbSchema([
        { name: "Home", path: "/" },
        { name: "Privacy Policy", path: "/privacy-policy/" },
    ]),
];
---

<Layout
    title="Privacy Policy — CleanBoard"
    description="CleanBoard collects no data. The app does not request the Internet permission and has no analytics or advertising SDK. Everything stays on your device."
    path="/privacy-policy/"
    jsonLd={jsonLd}
>
    <div class="container container--reading">
        <article class="prose policy">
            <header class="policy__head">
                <h1>Privacy Policy</h1>
                <p class="policy__meta">Last updated: {lastUpdated}</p>
            </header>

            <p>
                CleanBoard is built by heymeowcat. This policy explains what
                happens to your data — which, in short, is nothing, because the
                app has no way to send any.
            </p>

            <h2 id="no-collection">1. No data collection</h2>
            <p>
                CleanBoard does not collect, store, transmit, sell or share any
                personal data. We do not record your keystrokes, your typing
                history, your contacts, your location or your device identifier.
                We have no analytics pipeline, no advertising SDK, no
                crash-reporting service and no account system, because there is
                nothing for any of them to report.
            </p>

            <h2 id="no-internet-permission">2. No internet permission</h2>
            <p>
                The CleanBoard app does not request and does not use the Android
                <code>INTERNET</code> permission. This is not a promise — it is a
                technical guarantee. Without that permission the operating
                system will not let the app open a network connection, so the
                app is incapable of sending information from your device to a
                server.
            </p>

            <h2 id="permissions">3. Permissions the app does use</h2>
            <p>
                CleanBoard requests only the permissions that are strictly
                needed for the features you switch on:
            </p>
            <ul>
                <li>
                    <strong>Vibration</strong> — for haptic feedback when you
                    press a key, if you enable it in the settings.
                </li>
            </ul>

            <h2 id="website">4. This website</h2>
            <p>
                The website at <code>heymeowcat.is-a.dev/cleanboard-site</code>
                is a static site. It sets no cookies, runs no analytics and
                embeds no third-party scripts. The English-to-Sinhala converter
                runs entirely inside your browser using JavaScript that is
                served from this domain; the text you type is never transmitted
                anywhere.
            </p>
            <p>
                The site does load one external resource: a link to the Google
                Play listing, which only takes you to Google when you click it.
            </p>

            <h2 id="third-party">5. Third-party services</h2>
            <p>
                If you download CleanBoard from Google Play, Google Play
                handles the transaction and collects the data its own privacy
                policy describes. We never receive any of it. Likewise, if you
                choose to contact us by email, your email travels through your
                own mail provider.
            </p>

            <h2 id="children">6. Children</h2>
            <p>
                CleanBoard is safe for all ages. Because it collects no data,
                it collects no data from children either.
            </p>

            <h2 id="changes">7. Changes to this policy</h2>
            <p>
                If this policy ever changes, the update will be published on
                this page together with a new &ldquo;last updated&rdquo; date.
                Material changes will also be mentioned in the app&rsquo;s
                release notes.
            </p>

            <h2 id="contact">8. Contact</h2>
            <p>
                Questions about this policy can be sent to
                <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
            </p>
        </article>
    </div>
</Layout>

<style>
    .policy {
        padding-block: clamp(2.5rem, 6vw, 4rem) 1rem;
    }

    .policy__head {
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--border);
    }

    .policy h1 {
        font-size: clamp(1.875rem, 5vw, 2.5rem);
    }

    .policy__meta {
        margin-top: 0.5rem;
        font-size: 0.875rem;
    }
</style>
