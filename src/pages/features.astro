---
import Layout from "../layouts/Layout.astro";
import FeaturesContent from "../components/FeaturesContent.astro";
import { breadcrumbSchema, organizationSchema } from "../lib/schema";

const jsonLd = [
    organizationSchema(),
    breadcrumbSchema([
        { name: "Home", path: "/" },
        { name: "Features", path: "/features/" },
    ]),
];
---

<Layout
    title="Features — Sinhala Layouts, Gestures, Privacy"
    description="Four Sinhala layouts, a built-in Singlish engine, offline dictionaries, gesture typing and theming. Optional internet features are off by default."
    path="/features/"
    lang="en"
    alternates={{ en: "/features/", si: "/si/features/" }}
    jsonLd={jsonLd}
>
    <FeaturesContent lang="en" />
</Layout>
