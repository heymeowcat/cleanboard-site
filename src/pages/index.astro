---
import Layout from "../layouts/Layout.astro";
import HomeContent from "../components/HomeContent.astro";
import { faqs } from "../data/nav";
import {
    faqSchema,
    organizationSchema,
    softwareApplicationSchema,
    webSiteSchema,
} from "../lib/schema";

const lang = "en" as const;

const jsonLd = [
    organizationSchema(),
    webSiteSchema(),
    softwareApplicationSchema(),
    faqSchema(faqs.en.map((f) => ({ question: f.question, answer: f.answer }))),
];
---

<Layout
    title="Sinhala & English Keyboard — Free & Offline"
    description="Type Singlish and get සිංහල instantly. CleanBoard is a free, offline Android keyboard with a built-in English-to-Sinhala converter. No tracking."
    path="/"
    lang={lang}
    alternates={{ en: "/", si: "/si/" }}
    jsonLd={jsonLd}
>
    <HomeContent lang={lang} toolId="home-transliterator" />
</Layout>
