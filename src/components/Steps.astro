---
/**
 * Numbered how-it-works steps, shared by the home and converter pages.
 */
interface Step {
    title: string;
    body: string;
}

interface Props {
    steps: readonly Step[];
}

const { steps } = Astro.props;
---

<ol class="steps">
    {
        steps.map((step, index) => (
            <li class="step">
                <span class="step__num" aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                </span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
            </li>
        ))
    }
</ol>

<style>
    .steps {
        list-style: none;
        display: grid;
        gap: clamp(1rem, 2.5vw, 1.35rem);
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    }

    .step {
        position: relative;
        padding: clamp(1.35rem, 3vw, 1.8rem);
        padding-top: clamp(2.6rem, 5vw, 3rem);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        transition:
            transform 0.25s var(--ease-out),
            border-color 0.2s ease,
            box-shadow 0.25s var(--ease-out);
    }

    .step::before {
        content: "";
        position: absolute;
        top: 0;
        left: clamp(1.35rem, 3vw, 1.8rem);
        width: 3rem;
        height: 4px;
        border-radius: 0 0 4px 4px;
        background: var(--accent);
    }

    .step:hover {
        transform: translateY(-3px);
        border-color: var(--accent-line);
        box-shadow: var(--shadow);
    }

    .step__num {
        position: absolute;
        top: clamp(1rem, 2.4vw, 1.3rem);
        right: clamp(1.2rem, 2.8vw, 1.6rem);
        font-family: var(--font-display);
        font-size: 2rem;
        font-weight: 800;
        line-height: 1;
        letter-spacing: -0.04em;
        color: var(--accent);
        opacity: 0.28;
    }

    .step h3 {
        font-size: 1.0625rem;
        margin-bottom: 0.4rem;
    }

    .step p {
        font-size: 0.9375rem;
    }
</style>
