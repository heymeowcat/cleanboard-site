---
/**
 * FAQ accordion. The questions are rendered as a native <details> list so it
 * works without JavaScript, is keyboard accessible, and is crawlable.
 *
 * The same strings are reused by the FAQPage JSON-LD schema.
 */
import { faqs } from "../data/nav";

interface Props {
    lang?: "en" | "si";
}

const { lang = "en" } = Astro.props;
const items = faqs[lang];
---

<div class="faq">
    {
        items.map((item, index) => (
            <details class="faq__item" open={index === 0}>
                <summary class="faq__q">
                    <h3>{item.question}</h3>
                    <span class="faq__marker" aria-hidden="true" />
                </summary>
                <div class="faq__a">
                    <p>{item.answer}</p>
                </div>
            </details>
        ))
    }
</div>

<style>
    .faq {
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
    }

    .faq__item {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
    }

    .faq__item[open] {
        border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    }

    .faq__q {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 1.125rem;
        cursor: pointer;
        list-style: none;
        min-height: 3.25rem;
    }

    .faq__q::-webkit-details-marker {
        display: none;
    }

    .faq__q h3 {
        font-size: 1rem;
        font-weight: 600;
    }

    .faq__q:hover h3 {
        color: var(--accent-strong);
    }

    .faq__marker {
        position: relative;
        flex-shrink: 0;
        width: 1rem;
        height: 1rem;
    }

    .faq__marker::before,
    .faq__marker::after {
        content: "";
        position: absolute;
        top: 50%;
        left: 0;
        width: 100%;
        height: 2px;
        background: var(--muted-foreground);
        border-radius: 2px;
        transform: translateY(-50%);
        transition: transform 0.2s ease, opacity 0.2s ease;
    }

    .faq__marker::after {
        transform: translateY(-50%) rotate(90deg);
    }

    .faq__item[open] .faq__marker::after {
        transform: translateY(-50%) rotate(0deg);
        opacity: 0;
    }

    .faq__a {
        padding: 0 1.125rem 1.125rem;
    }

    .faq__a p {
        font-size: 0.9375rem;
    }
</style>
