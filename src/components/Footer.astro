---
/**
 * Site footer. The closing install CTA lives here as the top band of the
 * footer — not as a separate section — so the Play Store call to action and
 * the navigation links appear exactly once at the end of the page.
 */
import { footerGroups } from "../data/nav";
import PlayBadge from "./PlayBadge.astro";
import { BASE_PATH, PLAY_STORE_URL, SITE_NAME, localizedPath } from "../lib/site";

interface Props {
    lang: "en" | "si";
}

const { lang } = Astro.props;
const year = new Date().getFullYear();

const hrefFor = (path: string) => `${BASE_PATH}${localizedPath(lang, path)}`;
---

<footer class="site-footer">
    <span class="footer__glow footer__glow--a" aria-hidden="true"></span>
    <span class="footer__glow footer__glow--b" aria-hidden="true"></span>

    <div class="container footer__cta">
        <div class="footer__cta-copy">
            <p class="footer__eyebrow">
                {lang === "si" ? "App එක ගන්න" : "Get the app"}
            </p>
            <h2>
                {
                    lang === "si"
                        ? "Privacy එකට කරදරයක් නැතුව සිංහල type කරන්න."
                        : "Type Sinhala without giving up your privacy."
                }
            </h2>
            <p>
                {
                    lang === "si"
                        ? "CleanBoard Google Play එකේ free. Ads නැහැ, account නැහැ, core keyboard එක offline වැඩ කරනවා."
                        : "CleanBoard is free on Google Play — no ads, no account, and the core keyboard works offline."
                }
            </p>
        </div>
        <div class="footer__cta-actions">
            <a
                class="footer__badge"
                href={PLAY_STORE_URL}
                rel="noopener"
                target="_blank"
                aria-label={
                    lang === "si"
                        ? "Google Play හරහා CleanBoard බාගන්න"
                        : "Get CleanBoard on Google Play"
                }
            >
                <PlayBadge lang={lang} priority />
            </a>
            <span class="footer__cta-note">
                {lang === "si" ? "Free · Ads නැහැ · Tracking නැහැ" : "Free · No ads · No tracking"}
            </span>
        </div>
    </div>

    <div class="container footer__main">
        <div class="footer__brand">
            <a class="footer__logo" href={hrefFor("/")}>
                <img
                    src={`${BASE_PATH}/cleanboard-logo.png`}
                    alt=""
                    width="44"
                    height="44"
                    loading="lazy"
                    decoding="async"
                />
                <span>{SITE_NAME}</span>
            </a>
            <p class="footer__tagline">
                {
                    lang === "si"
                        ? "Sinhala සහ English වලට හදපු free, private, offline-first Android keyboard එකක්."
                        : "A free, private, offline-first Android keyboard for Sinhala and English."
                }
            </p>
        </div>

        {
            footerGroups.map((group) => (
                <nav
                    class="footer__col"
                    aria-label={lang === "si" ? group.si.title : group.en.title}
                >
                    <h2 class="footer__title">
                        {lang === "si" ? group.si.title : group.en.title}
                    </h2>
                    <ul>
                        {group.en.links.map((link) => (
                            <li>
                                <a href={hrefFor(link.path)}>
                                    {lang === "si"
                                        ? group.si.links.find(
                                              (l) => l.path === link.path,
                                          )?.label
                                        : link.label}
                                </a>
                            </li>
                        ))}
                    </ul>
                </nav>
            ))
        }
    </div>

    <div class="container footer__bottom">
        <p>
            &copy; {year} heymeowcat.
            <span class="footer__made">
                {lang === "si" ? "Sri Lanka එකේ හදපු" : "Made in Sri Lanka"}
            </span>
        </p>
    </div>
</footer>

<style>
    .site-footer {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        margin-top: 0;
        padding-block: clamp(2.75rem, 6vw, 4.5rem) 1.5rem;
        padding-bottom: calc(1.5rem + env(safe-area-inset-bottom));
        background:
            radial-gradient(120% 100% at 100% 0%, var(--footer-bg-2), transparent 60%),
            var(--footer-bg);
        color: var(--footer-fg);
        border-radius: clamp(1.5rem, 3.5vw, 2.5rem) clamp(1.5rem, 3.5vw, 2.5rem) 0 0;
    }

    .site-footer::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        opacity: 0.5;
        background-image: radial-gradient(rgb(255 255 255 / 5%) 1px, transparent 1px);
        background-size: 18px 18px;
        mask-image: linear-gradient(180deg, black, transparent 70%);
    }

    .footer__glow {
        position: absolute;
        z-index: -1;
        border-radius: 50%;
        filter: blur(80px);
        pointer-events: none;
    }

    .footer__glow--a {
        width: 34rem;
        height: 24rem;
        left: -10rem;
        top: -14rem;
        background: color-mix(in srgb, var(--accent) 42%, transparent);
        opacity: 0.55;
    }

    .footer__glow--b {
        width: 28rem;
        height: 22rem;
        right: -8rem;
        bottom: -12rem;
        background: var(--lime);
        opacity: 0.14;
    }

    .footer__cta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1.75rem 3rem;
        padding-bottom: clamp(2.25rem, 5vw, 3.5rem);
        border-bottom: 1px solid var(--footer-border);
    }

    .footer__cta-copy {
        flex: 1 1 26rem;
        max-width: 42rem;
    }

    .footer__eyebrow {
        font-size: 0.8125rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--footer-accent);
        margin-bottom: 0.8rem;
    }

    .footer__cta h2 {
        color: var(--footer-fg);
        font-size: clamp(1.85rem, 4.4vw, 2.9rem);
        max-width: 22ch;
    }

    .footer__cta p {
        color: var(--footer-muted);
        margin-top: 0.85rem;
        max-width: 46ch;
        font-size: 1.0625rem;
    }

    .footer__cta-actions {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.8rem;
    }

    .footer__badge {
        display: inline-block;
        border-radius: 0.55rem;
        transition: transform 0.2s var(--ease-out), opacity 0.2s ease;
    }

    .footer__badge:hover {
        transform: translateY(-3px);
        opacity: 0.94;
    }

    .footer__cta-note {
        font-size: 0.8125rem;
        color: var(--footer-muted);
        padding-left: 0.25rem;
    }

    .footer__main {
        display: grid;
        grid-template-columns: minmax(0, 1.7fr) repeat(2, minmax(8rem, 0.7fr));
        gap: clamp(2rem, 5vw, 3.5rem);
        padding-block: clamp(2rem, 5vw, 3rem);
    }

    @media (max-width: 44rem) {
        .footer__main {
            grid-template-columns: 1fr 1fr;
        }

        .footer__brand {
            grid-column: 1 / -1;
        }
    }

    .footer__logo {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-weight: 700;
        font-size: 1.0625rem;
        color: var(--footer-fg);
        text-decoration: none;
    }

    .footer__logo img {
        border-radius: 28%;
        background: rgb(255 255 255 / 8%);
    }

    .footer__tagline {
        margin-top: 0.85rem;
        font-size: 0.9375rem;
        max-width: 34ch;
        color: var(--footer-muted);
    }

    .footer__title {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--footer-accent);
        margin-bottom: 0.9rem;
    }

    .footer__col ul {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }

    .footer__col a {
        display: inline-flex;
        align-items: center;
        min-height: 2rem;
        font-size: 0.9375rem;
        color: var(--footer-muted);
        text-decoration: none;
        transition: color 0.18s ease;
    }

    .footer__col a:hover {
        color: var(--footer-fg);
        text-decoration: underline;
        text-underline-offset: 0.25em;
    }

    .footer__bottom {
        padding-top: 1.5rem;
        border-top: 1px solid var(--footer-border);
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1.5rem;
        justify-content: space-between;
        align-items: center;
        font-size: 0.8125rem;
        color: var(--footer-muted);
    }

    .footer__bottom p {
        color: var(--footer-muted);
    }

    .footer__made {
        margin-left: 0.35rem;
    }

    @media (max-width: 36rem) {
        .footer__col a {
            min-height: 2.75rem;
        }
    }
</style>
