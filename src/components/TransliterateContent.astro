---
/**
 * The body of the English → Sinhala converter page, shared by
 * `/transliterate/` and `/si/transliterate/`.
 */
import Transliterator from "./Transliterator.astro";
import Faq from "./Faq.astro";
import CtaBanner from "./CtaBanner.astro";
import { benefits, steps } from "../data/content";
import { BASE_PATH } from "../lib/site";

interface Props {
    lang: "en" | "si";
    toolId: string;
}

const { lang, toolId } = Astro.props;

const examples = {
    en: [
        ["ayubowan", "ආයුබෝවන්", "Hello"],
        ["kohomada hodai", "කොහොමද හොඳයි", "How are you?"],
        ["mama sinhala dannanawa", "මම සිංහල දන්නවා", "I know Sinhala"],
        ["subha divasak", "සුභ දිනයක්", "Good morning"],
        ["karunakara", "කරුණාකර", "Please"],
        ["mokakda hodai", "මොකක්ද හොඳයි", "What's good?"],
        ["sri lanka", "ශ්‍රී ලංකා", "Sri Lanka"],
        ["govi mahanama", "ගෝවි මහනාමය", "Parliament"],
    ],
    si: [
        ["ayubowan", "ආයුබෝවන්", "ආයුබෝවන්"],
        ["kohomada hodai", "කොහොමද හොඳයි", "කොහොමද හොඳයි"],
        ["mama sinhala dannanawa", "මම සිංහල දන්නවා", "මම සිංහල දන්නවා"],
        ["subha divasak", "සුභ දිනයක්", "සුභ දිනයක්"],
        ["karunakara", "කරුණාකර", "කරුණාකර"],
        ["mokakda hodai", "මොකක්ද හොඳයි", "මොකක්ද හොඳයි"],
        ["sri lanka", "ශ්‍රී ලංකා", "ශ්‍රී ලංකා"],
        ["govi mahanama", "ගෝවි මහනාමය", "ගෝවි මහනාමය"],
    ],
} as const;
---

<section class="tool-hero">
    <div class="container">
        <div class="tool-hero__head">
            <p class="eyebrow">
                {lang === "si" ? "නොමිලේ · ගිණුමක් නැත · උඩුගානනයක් නැත" : "Free · No sign-up · No upload"}
            </p>
            <h1>
                {
                    lang === "si"
                        ? "ඉංග්‍රීසි සිට සිංහල අකුරු පරිවර්තනය"
                        : "English to Sinhala transliteration"
                }
            </h1>
            <p class="lede">
                {
                    lang === "si"
                        ? "ඉංග්‍රීසි අකුරු ලියන්න, සිංහල ස්වයංක්‍රීයව ලබා ගන්න. මෙය CleanBoard ඇන්ඩ්‍රොයිඩ් යතුරුපුවරුව තුළ ධඟුන එකම පරිවර්තන එංජිනය වන අතර එය සම්පූර්ණයෙන්ම ඔබගේ බ්‍රවුසරය තුළම ක්‍රියා කරයි."
                        : "Type in English letters and get Sinhala සිංහල back instantly. This is the same transliteration engine that runs inside the CleanBoard Android keyboard, running entirely in your browser."
                }
            </p>
        </div>

        <div class="tool-hero__converter">
            <Transliterator lang={lang} id={toolId} />
        </div>

        <p class="tool-hero__note">
            {
                lang === "si"
                    ? "පරිවර්තකයක් නොවේ යතුරුපුවරුවක් ඕනේද?"
                    : "Looking for a keyboard rather than a converter?"
            }
            <a href={`${BASE_PATH}/download/`}>
                {lang === "si" ? "Android සඳහා CleanBoard ගන්න" : "Get CleanBoard for Android"}
            </a>
            {
                lang === "si"
                    ? " සහ ඕනෑම යෙදුමේ ලියද්දීම එම පරිවර්තනය ලබා ගන්න."
                    : " and get the same conversion while you type in any app."
            }
        </p>
    </div>
</section>

<section class="section section--alt" aria-labelledby="benefits-heading">
    <div class="container">
        <div class="section__head">
            <h2 id="benefits-heading">
                {
                    lang === "si"
                        ? "මෙම පරිවර්තකය භාවිත කරන්නේ ඇයි"
                        : "Why use this converter"
                }
            </h2>
        </div>
        <ul class="benefits">
            {
                benefits[lang].map((benefit) => (
                    <li>
                        <svg
                            aria-hidden="true"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M20 6 9 17l-5-5" />
                        </svg>
                        <span>{benefit}</span>
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<section class="section" aria-labelledby="how-heading">
    <div class="container">
        <div class="section__head">
            <h2 id="how-heading">
                {
                    lang === "si"
                        ? "ඉංග්‍රීසියෙන් සිංහලට පරිවර්තනය කරන ආකාරය"
                        : "How to convert English to Sinhala"
                }
            </h2>
            <p>
                {
                    lang === "si"
                        ? "භාෂා දරශයන් දැනටමත් භාවිත කරන රූපමත ගමන් පිළිබඳ ගමන් මෙම එංජිනය නිවැරදි සිංහල අකුරු ලියුමට හරවයි."
                        : "The rules are the ones Sinhala speakers already use: write the word the way it sounds, and the engine turns it into the correct Sinhala spelling."
                }
            </p>
        </div>

        <ol class="steps">
            {
                steps[lang].map((step, index) => (
                    <li class="steps__item">
                        <span class="steps__num" aria-hidden="true">
                            {index + 1}
                        </span>
                        <div>
                            <h3>{step.title}</h3>
                            <p>{step.body}</p>
                        </div>
                    </li>
                ))
            }
        </ol>

        <div class="examples">
            <h3>{lang === "si" ? "උදාන්‍ය උදාහරණ" : "Everyday examples"}</h3>
            <div class="table-wrap">
                <table class="examples__table">
                    <caption class="visually-hidden">
                        {
                            lang === "si"
                                ? "නොතිරාත්තර ඉංග්‍රීසි වාක්‍ය සහ ඒවාගේ සිංහල පරිවර්තනය"
                                : "Common English phrases and their Sinhala transliteration"
                        }
                    </caption>
                    <thead>
                        <tr>
                            <th scope="col">
                                {lang === "si" ? "ඉංග්‍රීසි (Singlish)" : "English (Singlish)"}
                            </th>
                            <th scope="col">සිංහල</th>
                            <th scope="col">
                                {lang === "si" ? "අර්ථය" : "Meaning"}
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {
                            examples[lang].map((row) => (
                                <tr>
                                    <td>{row[0]}</td>
                                    <td class="sinhala">{row[1]}</td>
                                    <td>{row[2]}</td>
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<section class="section section--alt" aria-labelledby="faq-heading">
    <div class="container container--narrow">
        <div class="section__head">
            <h2 id="faq-heading">
                {lang === "si" ? "නොතිරාත්තර ප්‍රශ්න" : "Frequently asked questions"}
            </h2>
        </div>
        <Faq lang={lang} />
    </div>
</section>

<CtaBanner
    lang={lang}
    title={
        lang === "si"
            ? "කෙලින්ම සිංහල ලියන්න ඕනේද?"
            : "Prefer to type Sinhala directly?"
    }
    body={
        lang === "si"
            ? "CleanBoard ස්ථාපනය කරන්න. WhatsApp, Gmail හෝ ඔබගේ දුරකථනයේ ඕනෑම යෙදුමේ ලියද්දීම එම පරිවර්තනය ලබා ගන්න — පරිවර්තනය නොබැඳිව ක්‍රියා කරයි."
            : "Install CleanBoard and get the same transliteration while you type in WhatsApp, Gmail or any other app on your phone — the conversion works offline."
    }
    links={[
        {
            href: "/features/",
            label: lang === "si" ? "සියලුම විශේෂ ලක්ෂණ" : "See all features",
        },
        {
            href: "/transliteration-chart/",
            label: lang === "si" ? "අකුරු පරිවර්තන චාර්ටය" : "Transliteration chart",
        },
    ]}
/>

<style>
    .tool-hero {
        padding-block: clamp(2.5rem, 7vw, 4rem) clamp(2rem, 5vw, 3rem);
    }

    .tool-hero__head {
        max-width: 44rem;
        margin-inline: auto;
        text-align: center;
    }

    .tool-hero h1 {
        font-size: clamp(1.875rem, 6vw, 3rem);
    }

    .tool-hero__head .lede {
        margin-top: 0.85rem;
    }

    .tool-hero__converter {
        max-width: 58rem;
        margin: clamp(1.75rem, 4vw, 2.5rem) auto 0;
        text-align: left;
    }

    .tool-hero__note {
        margin-top: 1.25rem;
        text-align: center;
        font-size: 0.9375rem;
    }

    .sinhala {
        font-family: "Noto Sans Sinhala", var(--font-sans);
    }

    .benefits {
        list-style: none;
        display: grid;
        gap: 0.875rem;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    }

    .benefits li {
        display: flex;
        align-items: flex-start;
        gap: 0.65rem;
        font-size: 0.9375rem;
        color: var(--muted-foreground);
    }

    .benefits svg {
        flex-shrink: 0;
        margin-top: 0.2rem;
        color: var(--accent-strong);
    }

    .steps {
        list-style: none;
        display: grid;
        gap: 1.25rem;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    }

    .steps__item {
        display: flex;
        gap: 1rem;
        align-items: flex-start;
    }

    .steps__num {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.25rem;
        height: 2.25rem;
        flex-shrink: 0;
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--accent-strong);
        font-weight: 700;
        font-size: 0.9375rem;
    }

    .steps__item h3 {
        font-size: 1.0625rem;
        margin-bottom: 0.35rem;
    }

    .steps__item p {
        font-size: 0.9375rem;
    }

    .examples {
        margin-top: clamp(2rem, 5vw, 3rem);
    }

    .examples h3 {
        font-size: 1.125rem;
        margin-bottom: 0.85rem;
    }

    .table-wrap {
        overflow-x: auto;
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        background: var(--surface);
        -webkit-overflow-scrolling: touch;
    }

    .examples__table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9375rem;
        min-width: 30rem;
    }

    .examples__table th,
    .examples__table td {
        text-align: left;
        padding: 0.7rem 1rem;
        border-bottom: 1px solid var(--border);
    }

    .examples__table thead th {
        background: var(--surface-2);
        color: var(--foreground);
        font-weight: 600;
        white-space: nowrap;
    }

    .examples__table tbody tr:last-child td {
        border-bottom: 0;
    }

    .examples__table td.sinhala {
        font-family: "Noto Sans Sinhala", var(--font-sans);
        font-size: 1.0625rem;
        color: var(--foreground);
    }
</style>
