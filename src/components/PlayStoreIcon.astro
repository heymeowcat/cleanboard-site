---
/**
 * The official Google Play icon — the four-colour triangle from the 2022
 * Google Play logo.
 *
 * The paths are the official artwork (identical to the mark inside the
 * "Get it on Google Play" badge), reproduced here so the compact header
 * button can use the real mark at any size without loading a raster image.
 *
 * Source: https://en.wikipedia.org/wiki/File:Google_Play_2022_logo.svg
 * "Google Play" is a trademark of Google LLC. This icon is used to
 * identify the store the app is available from.
 */
interface Props {
    /** Rendered size in pixels. */
    size?: number;
    class?: string;
}

const { size = 18, class: className } = Astro.props;
---

<svg
    class={className}
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 466 511.98"
    width={size}
    height={size}
    fill="none"
    role="img"
    aria-hidden="true"
    focusable="false"
>
    <path
        fill="#EA4335"
        d="M199.9 237.8 1.4 470.17c7.22 24.57 30.16 41.81 55.8 41.81 11.16 0 20.93-2.79 29.3-8.37l244.16-139.46L199.9 237.8Z"
    ></path>
    <path
        fill="#FBBC04"
        d="m433.91 205.1-104.65-60-111.61 110.22 113.01 108.83 104.64-58.6c18.14-9.77 30.7-29.3 30.7-50.23-1.4-20.93-13.95-40.46-32.09-50.22Z"
    ></path>
    <path
        fill="#34A853"
        d="M199.42 273.45 329.27 145.1 87.9 8.37C79.53 2.79 68.36 0 57.2 0 30.7 0 6.98 18.14 1.4 41.86l198.02 231.59Z"
    ></path>
    <path
        fill="#4285F4"
        d="M1.39 41.86C0 46.04 0 51.63 0 57.2v397.64c0 5.57 0 9.76 1.4 15.34l216.27-214.86L1.39 41.86Z"
    ></path>
</svg>

<style>
    svg {
        flex-shrink: 0;
        display: block;
    }
</style>
