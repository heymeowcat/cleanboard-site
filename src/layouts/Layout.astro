---
/**
 * Base document layout: everything that belongs in `<head>` for a
 * well-optimised, indexable page lives here.
 *
 * Every page gets:
 *  - a unique <title> and meta description
 *  - a canonical URL (plus x-default / hreflang alternates)
 *  - a robots directive (index, follow by default)
 *  - Open Graph + Twitter card metadata with a real og:image
 *  - JSON-LD structured data
 *  - preloaded self-hosted fonts
 */
import FontStyles, { criticalFonts } from "../components/FontStyles.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import {
    DEFAULT_DESCRIPTION,
    LOCALE,
    OG_IMAGE,
    SITE_NAME,
    absoluteUrl,
    bingToken,
    gscToken,
} from "../lib/site";

export interface Props {
    /** Full page title. The site name is appended automatically when missing. */
    title: string;
    description?: string;
    /** Site-relative path *without* the base path, e.g. "/transliterate/". */
    path: string;
    /** Document language. */
    lang?: "en" | "si";
    /** Set to true only for pages that must not appear in search results. */
    noindex?: boolean;
    ogType?: "website" | "article";
    /** Overrides the default Open Graph image. */
    ogImage?: { path: string; width: number; height: number; alt: string };
    /** JSON-LD objects, serialised into `application/ld+json` script tags. */
    jsonLd?: Record<string, unknown>[];
    /** Hreflang alternates for the same content in other languages. */
    alternates?: { en?: string; si?: string };
    /** Extra <link rel="stylesheet"> / preload hints. */
    preload?: Array<{ href: string; as: string; type?: string; crossorigin?: boolean }>;
}

const {
    title,
    description = DEFAULT_DESCRIPTION,
    path,
    lang = "en",
    noindex = false,
    ogType = "website",
    ogImage = OG_IMAGE,
    jsonLd = [],
    alternates = {},
    preload = [],
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");

/** The canonical URL always points at the trailing-slash form. */
const canonical = absoluteUrl(path);

const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;

const ogImageUrl = absoluteUrl(ogImage.path);

const alternateLinks = Object.entries(alternates)
    .filter(([, p]) => Boolean(p))
    .map(([code, p]) => ({
        hreflang: code,
        href: absoluteUrl(p as string),
    }));

---

<!doctype html>
<html lang={lang} data-base={base}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <meta name="generator" content={Astro.generator} />

        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />

        {
            alternateLinks.map((alt) => (
                <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
            ))
        }
        {
            alternateLinks.length > 0 && (
                <link
                    rel="alternate"
                    hreflang="x-default"
                    href={
                        alternateLinks.find((a) => a.hreflang === "en")?.href ??
                        canonical
                    }
                />
            )
        }

        <meta
            name="robots"
            content={
                noindex
                    ? "noindex, nofollow"
                    : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
            }
        />
        <meta name="googlebot" content={noindex ? "noindex" : "index, follow"} />

        <!-- Open Graph -->
        <meta property="og:site_name" content={SITE_NAME} />
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:width" content={String(ogImage.width)} />
        <meta property="og:image:height" content={String(ogImage.height)} />
        <meta property="og:image:alt" content={ogImage.alt} />
        <meta property="og:locale" content={LOCALE[lang]} />
        {
            lang !== "en" && (
                <meta property="og:locale:alternate" content={LOCALE.en} />
            )
        }

        <!-- Twitter / X card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageUrl} />
        <meta name="twitter:image:alt" content={ogImage.alt} />

        <!-- Icons & installability -->
        <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
        <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
        <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16.png`} />
        <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
        <link rel="mask-icon" href={`${base}/favicon.svg`} color="#10b981" />
        <link rel="manifest" href={`${base}/site.webmanifest`} />
        <meta name="theme-color" content="#10b981" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#020617" media="(prefers-color-scheme: dark)" />
        <meta name="application-name" content={SITE_NAME} />
        <meta name="apple-mobile-web-app-title" content={SITE_NAME} />
        <meta name="format-detection" content="telephone=no" />

        <!-- Search Console verification (set gscToken in src/lib/site.ts) -->
        {
            gscToken && (
                <meta
                    name="google-site-verification"
                    content={gscToken}
                />
            )
        }
        {
            bingToken && (
                <meta name="msvalidate.01" content={bingToken} />
            )
        }

        <!-- Font preloads: the two faces used above the fold. -->
        {
            criticalFonts.map((href) => (
                <link
                    rel="preload"
                    href={href}
                    as="font"
                    type="font/woff2"
                    crossorigin
                />
            ))
        }
        {
            preload.map((hint) => (
                <link
                    rel="preload"
                    href={hint.href}
                    as={hint.as}
                    type={hint.type}
                    crossorigin={hint.crossorigin}
                />
            ))
        }

        <FontStyles />

        {
            jsonLd.map((schema) => (
                <script
                    type="application/ld+json"
                    is:inline
                    set:html={JSON.stringify(schema)}
                />
            ))
        }
    </head>

    <body>
        <a class="skip-link" href="#main">Skip to content</a>

        <Header
            lang={lang}
            path={path}
            altPath={alternates.si ?? alternates.en ?? path}
            altLabel={lang === "en" ? "සිංහල" : "EN"}
        />

        <main id="main">
            <slot />
        </main>

        <Footer lang={lang} />
    </body>
</html>
