---
interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "CleanBoard - Fast, Private, and Modern Singlish Keyboard for Android",
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta
            name="keywords"
            content="CleanBoard, Sinhala Keyboard, Singlish Keyboard, Android Keyboard, Private Keyboard, Minimalist Keyboard, සිංහල යතුරුපුවරුව"
        />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Sinhala:wght@400;500;700&family=Outfit:wght@400;500;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <main>
            <slot />
        </main>
        <footer>
            <div class="container">
                <p id="footer-text">
                    &copy; {new Date().getFullYear()} heymeowcat. <a
                        href={`${base}/privacy-policy`}
                        id="privacy-link">Privacy Policy</a
                    > | <a href={`${base}/terms-of-service`} id="terms-link"
                        >Terms of Service</a
                    >
                </p>
            </div>
        </footer>
    </body>
</html>

<style is:global>
    :root {
        --background: #ffffff;
        --foreground: #0f172a;
        --accent: #10b981;
        --accent-foreground: #ffffff;
        --muted: #f1f5f9;
        --muted-foreground: #64748b;
    }

    @media (prefers-color-scheme: dark) {
        :root {
            --background: #020617;
            --foreground: #f8fafc;
            --muted: #0f172a;
            --muted-foreground: #94a3b8;
        }
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family:
            "Outfit",
            "IBM Plex Sans Sinhala",
            system-ui,
            -apple-system,
            sans-serif;
        background-color: var(--background);
        color: var(--foreground);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    main {
        flex: 1;
    }

    .container {
        max-width: 800px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    footer {
        padding: 4rem 0 2rem;
        text-align: center;
        font-size: 0.875rem;
        color: var(--muted-foreground);
    }

    a {
        color: var(--foreground);
        text-decoration: none;
        transition: opacity 0.2s;
    }

    a:hover {
        opacity: 0.7;
    }

    h1,
    h2,
    h3 {
        font-weight: 700;
        letter-spacing: -0.025em;
    }

    p {
        color: var(--muted-foreground);
    }
</style>
